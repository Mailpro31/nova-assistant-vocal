# ─────────────────────────────────────────────────────────────
#  Nova — .gitignore
#  RIEN de personnel ni de sensible ne doit partir sur GitHub.
# ─────────────────────────────────────────────────────────────

# Secrets & données utilisateur (JAMAIS versionnés)
# CLÉ PRIVÉE de signature des licences (infalsifiabilité — JAMAIS sur GitHub) :
license_private.pem
*.pem
# clés API chiffrées DPAPI :
secrets.json
.env
.env.*
# réglages locaux (profil actif, statut fournisseurs) :
config.json
# automatisations perso :
commands.json
# notes dictées :
notes.json
# SQLite : historique, mémoire, contacts, adresse… :
nova.db
nova.db-wal
nova.db-shm
nova.log
# script TTS généré au runtime :
novatts.ps1
jarvis_*.json

# Environnements Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build PyInstaller
build/
dist/
*.spec
*.manifest

# Outils / caches internes
.impeccable/
**/.impeccable/

# OS / éditeurs
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Modèles Whisper téléchargés localement (lourds, re-téléchargés au besoin)
models/
# Exception : les poids OCR de la lecture de contexte sont hébergés par le site
# (servis en statique par Vercel), ils DOIVENT être versionnés.
!landing/models/
!landing/models/*.rten
*.bin
*.pt

# Vidéo d'onboarding (lourde, propre à chaque build — voir assets/README.md)
assets/*.mp4

# bande-son du film (régénérable via landing/film/audio.py)
landing/film/nova-film-audio.wav
nova-crash.log
nova.log.1
